  // Disable button while loading
  btn.disabled = true;
  btn.textContent = 'Loading... (20-30s)';
  
  const data = await loadDetailedInnings();
  
  if (data) {
    btn.textContent = '✅ Innings Loaded';
    btn.style.background = '#198754';
    btn.disabled = false;
    
    // Re-render to show detailed innings in the UI
    render();
    toast('✅ Detailed innings now visible!');
  } else {
    btn.textContent = 'Load Innings';
    btn.disabled = false;
  }
});

// Toggle virtual scrolling
$("#toggleVirtualScrollBtn")?.addEventListener('click', () => {
  const btn = $("#toggleVirtualScrollBtn");
  if (!btn) return;
  
  const totalGames = SCHED?.games?.length || 0;
  
  // Warn if disabling with lots of games
  if (virtualScrollEnabled && totalGames > 200) {
    const confirm = window.confirm(
      `⚠️ WARNING: You have ${totalGames} games!\n\n` +
      `Disabling virtual scrolling will render ALL games at once and may cause:\n` +
      `• Page freezing for 10-30 seconds\n` +
      `• Slow scrolling\n` +
      `• Browser lag\n\n` +
      `Are you sure you want to disable virtual scrolling?`
    );
    if (!confirm) return;
  }
  
  virtualScrollEnabled = !virtualScrollEnabled;
  btn.textContent = `Virtual Scroll: ${virtualScrollEnabled ? 'ON' : 'OFF'}`;
  btn.style.background = virtualScrollEnabled ? '#6c757d' : '#dc3545';
  
  // Reset visible range when toggling
  visibleRange = { start: 0, end: 100 }; // 50 rows x 2 columns
  
  render();
  
  if (!virtualScrollEnabled && totalGames > 200) {
    toast('⚠️ Rendering all games... this may take a moment');
  } else {
    toast(virtualScrollEnabled ? '✅ Virtual scrolling enabled' : '⚠️ Virtual scrolling disabled');
  }
});

