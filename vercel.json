{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/update",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/schedule.html" }
  ]
}
