            <script>
                require(["knockout", "jquery", "jquery-ui", "headroom", "jquery-headroom"], function (ko, $) {
			                  
                    $(document).ready(function(){
                        $(window).scroll(function(){
                            if($(window).scrollTop()>100){
                                $(".slide").clearQueue().animate({bottom:"-100%"}, 300);
                            }
                            if($(window).scrollTop()<100){
                                $(".slide").clearQueue().animate({bottom:"0px"}, 300);
                            }
                        })
                    });
	
                    var fixPosition = $('#topleaderboard').outerHeight();
                    //On resize
                    $(window).resize(function(){
                        fixPosition = $('#topleaderboard').outerHeight();
                        $('.main-navigation').headroom('destroy').removeData('headroom').headroom({ offset: fixPosition});
                        $('.c-nav-sport').headroom('destroy').removeData('headroom').headroom({ offset: fixPosition});
                    }).trigger('resize');
                    //create mutationobservable to detect when the ad image is loaded, then change the top positioning of header
                    var targetNode = document.querySelector('#topleaderboard ads-component');
                    var config = { attributes: true, childList: true, subtree: true };
                    var callback = function(mutationsList, observer) {
                        for(var mutation of mutationsList) {
                            if (mutation.type == 'attributes') {
                                if (mutation.attributeName == 'height') {
                                    fixPosition = $("#topleaderboard").outerHeight();
                                    $('.main-navigation').headroom('destroy').removeData('headroom').headroom({ offset: fixPosition});
                                    $('.c-nav-sport').headroom('destroy').removeData('headroom').headroom({ offset: fixPosition});
                                    observer.disconnect();
                                }
                            }
                        }
                    };
                    var observer = new MutationObserver(callback);
                    observer.observe(targetNode, config);
               });
            </script>

        
