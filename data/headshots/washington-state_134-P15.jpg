                                    <div data-bind="stopBindings: true" class="hide" aria-hidden="true">
				                        <div id="sidearm-roster-player-extra-original" class="sidearm-roster-player-extra">
					
					                        <!-- ko if: isLoading -->
						                        <div data-bind="progressBar: true"></div>
					                        <!-- /ko -->

					                        <!-- ko ifnot: isLoading -->
						
						                        <!-- ko if: !stats() && !stories() -->
							                        <div class="sidearm-roster-player-extra-no-info">
                                                        <!-- ko if: hideBio -->
                                                        <p>
									                        There is no additional information to display.
								                        </p>
                                                        <!-- /ko -->
                                                        <!-- ko ifnot: hideBio -->
                                                        <p>
									                        There is no additional information to display:
									                        <a data-bind="click: function() { return true; }, clickBubble: false, attr: { href: url }">View Full Bio</a>
								                        </p>
                                                        <!-- /ko -->
								                        
							                        </div>
						                        <!-- /ko -->

						                        <!-- ko if: stats() && !stories() -->

							                        <div class="sidearm-roster-player-extra-stats">

								                        <div class="sidearm-roster-player-extra-stats-tabs">
									                        <ul class="flex" data-bind="foreach: stats">
										                        <li data-bind="text: title, clickBubble: false, click: $parent.selectStatCategory, css: { 'sidearm-roster-player-extra-stats-tabs-selected': selected }"></li>
									                        </ul>

									                        <!-- ko foreach: stats -->
										                        <div class="sidearm-roster-player-extra-stats-category" data-bind="visible: selected">
											                        <table class="sidearm-table">
												                        <caption class="hide">Player Statistics</caption>
												                        <thead>
													                        <tr data-bind="foreach: headings">
														                        <th scope="col" data-bind="text: $data">Statistic</th>
													                        </tr>
												                        </thead>
												                        <tbody>
													                        <!-- ko foreach: data -->
														                        <tr>
															                        <!-- ko foreach: $data -->
																                        <td data-bind="click: function() { return true; }, clickBubble: false, html: value, attr: { 'data-label': label }"></td>
															                        <!-- /ko -->
														                        </tr>
													                        <!-- /ko -->
												                        </tbody>
											                        </table>
										                        </div>
									                        <!-- /ko -->
								                        </div>
							                        </div>

						                        <!-- /ko -->

						                        <!-- ko if: !stats() && stories() -->
							                        <div class="sidearm-roster-player-extra-stories-only row pad">
								                        <div class="sidearm-roster-player-extra-stories columns">
                                                            
                                                                <h4 class="sidearm-roster-player-extra-heading">Headlines</h4>
                                                            
									                        <ul class="flex flex-column medium-flex-row row" data-bind="foreach: stories">
										                        <li class="x-small-12 medium-4 columns sidearm-roster-player-extra-story">
											                        <!-- ko if: image -->
											                        <div class="sidearm-roster-player-stories-media hide-on-small-down">
												                        <img data-bind="attr: { src: image + '?width=400&height=200&mode=crop' }" alt="">
											                        </div>
											                        <!-- /ko -->
											                        <span data-bind="formatDate: date, format: 'MMM. D'"></span>
