								                        <div class="sidearm-roster-player-extra-stats x-small-12 large-8 columns">
									                        <ul class="flex" data-bind="foreach: stats">
										                        <li data-bind="click: $parent.selectStatCategory, clickBubble: false, css: { 'sidearm-roster-player-extra-stats-tabs-selected' : selected }">
											                        <span class="hide-on-medium" data-bind="text: title_short"></span>
											                        <span class="hide-on-small-down" data-bind="text: title"></span>
										                        </li>
